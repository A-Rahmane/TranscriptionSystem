{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "TranscriptionService": "Debug"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=transcription_db;User=root;Password=password;"
  },
  "Whisper": {
    "ExecutablePath": "/usr/local/bin/whisper",
    "ModelsPath": "/var/models/whisper",
    "MaxConcurrentJobs": 2,
    "TimeoutSeconds": 3600,
    "Threads": 4,
    "EnableGpu": false,
    "OutputFormat": "json"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "QueueName": "transcription-jobs",
    "ExchangeName": "transcription-exchange",
    "DeadLetterQueueName": "transcription-jobs-dlq",
    "PrefetchCount": 1,
    "Durable": true,
    "RetryDelaySeconds": 60
  },
  "FileStorage": {
    "BasePath": "/var/transcription-files",
    "RetentionDays": 7,
    "EnableAutoCleanup": true
  }
}
